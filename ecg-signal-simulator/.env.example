# ============================================================
# Copia este archivo como ".env" y ajusta los valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ============================================================

# --- Servidor web ---
PORT=3000

# --- MySQL (XAMPP) ---
# XAMPP trae MySQL/MariaDB con usuario "root" y SIN contraseña por defecto.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arduino_ecg
DB_USER=root
DB_PASSWORD=
# true  = Sequelize crea/actualiza las tablas al iniciar (lo más simple)
# false = usa únicamente las tablas importadas desde database/schema.sql
DB_SYNC=true

# --- Seguridad ---
# Cambia este valor por una cadena larga y aleatoria. Ejemplo para generarla:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_HORAS=8
# Pon true solo si sirves la página por HTTPS
COOKIE_SECURE=false

# --- Arduino ---
# serial   = lee el Arduino real por USB
# simulate = emula un Arduino (útil para probar sin hardware)
ARDUINO_MODE=serial
# auto = busca la placa sola (Arduino, CH340, FTDI, CP210x) e ignora los puertos Bluetooth.
# También puedes fijarlo: Windows COM5 | Linux /dev/ttyUSB0 o /dev/ttyACM0 | macOS /dev/cu.usbmodemXXXX
# Para ver los puertos disponibles:  npm run puertos
# IMPORTANTE: el Arduino IDE puede seguir abierto, pero cierra su Monitor Serie / Serial Plotter
# (en Windows solo un programa a la vez puede usar el puerto).
ARDUINO_PORT=auto
ARDUINO_BAUD=115200
# Cuentas del ADC por cada mV de ECG (AD8232, ganancia 1100, ref. 5 V ≈ 225)
ARDUINO_COUNTS_PER_MV=225
# Frecuencia de muestreo inicial anunciada por el Arduino (Hz)
ARDUINO_FS=250
