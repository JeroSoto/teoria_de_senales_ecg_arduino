{
  "name": "ecg-signal-simulator",
  "version": "2.0.0",
  "description": "Simulador ECG en tiempo real + Arduino (serial) + usuarios en MySQL (Express y Sequelize) para Teoría de Señales",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "analyze": "python3 scripts/analisis_fft.py",
    "test": "node --test --test-concurrency=1 tests/detector.test.js tests/bridge.test.js tests/config.test.js tests/api.test.js",
    "db:check": "node scripts/probar-conexion-db.js",
    "usuario": "node scripts/crear-usuario.js",
    "puertos": "node scripts/listar-puertos.js",
    "migrar-nube": "node scripts/migrar-a-la-nube.js"
  },
  "keywords": [
    "ecg",
    "signal-processing",
    "teoria-de-senales",
    "fft",
    "biomedical",
    "nodejs",
    "javascript",
    "canvas",
    "python",
    "arduino",
    "mysql",
    "sequelize",
    "express",
    "ad8232"
  ],
  "author": "Jerónimo Soto Villada & Milady Cristina Guapacha Montoya",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "serialport": "^13.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
